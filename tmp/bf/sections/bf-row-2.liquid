{%- render 'christmas-row', section: section -%}

{% schema %}
{
 "name": "Black Friday: products 2",
 "settings": [
  {
   "type": "text",
   "id": "collection_handle",
   "label": "Collection handle to pull products from",
   "default": "cookware",
   "info": "Only in-stock products are shown, newest first. Up to 250 products are scanned."
  },
  {
   "type": "checkbox",
   "id": "row_alt",
   "label": "Cream background",
   "default": false
  },
  {
   "type": "text",
   "id": "row_title",
   "label": "Heading",
   "default": "Kitchen and cookware"
  },
  {
   "type": "text",
   "id": "row_text",
   "label": "Text",
   "default": "Pans, pots and kitchen essentials from the brands you know."
  },
  {
   "type": "text",
   "id": "row_url",
   "label": "Shop all link",
   "default": "/collections/cookware"
  },
  {
   "type": "text",
   "id": "row_keywords",
   "label": "Keywords (comma separated, blank = all)",
   "default": ""
  },
  {
   "type": "number",
   "id": "row_min",
   "label": "Min price $ (0 = none)",
   "default": 0
  },
  {
   "type": "number",
   "id": "row_max",
   "label": "Max price $ (0 = none)",
   "default": 0
  },
  {
   "type": "range",
   "id": "row_limit",
   "label": "Products",
   "min": 4,
   "max": 12,
   "step": 4,
   "default": 8
  },
  {
   "type": "text",
   "id": "row_anchor",
   "label": "Anchor id",
   "default": ""
  }
 ]
}
{% endschema %}
